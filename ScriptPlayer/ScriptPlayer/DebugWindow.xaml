<Window x:Class="ScriptPlayer.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug Console" Height="400" Width="800" 
        WindowStartupLocation="Manual"
        Left="0" Top="0">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="DebugTextBox" 
                     Background="Black" 
                     Foreground="Lime" 
                     FontFamily="Courier New"
                     FontSize="12"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Padding="5"/>
        </ScrollViewer>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <Button Click="ClearButton_Click" Padding="10,5" Margin="5">Clear</Button>
            <Button Click="CopyButton_Click" Padding="10,5" Margin="5">Copy All</Button>
        </StackPanel>
    </Grid>
</Window>
